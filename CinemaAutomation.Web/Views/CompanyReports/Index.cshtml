@{
    ViewData["Title"] = "Company Reports"; // Sets the page title
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
        letter-spacing: 0.4px;
    }

    .page-sub {
        color: #6b7280;
        margin-bottom: 28px;
        font-size: 0.95rem;
    }

    /* Filter */
    .filter-card {
        background: linear-gradient(135deg, #ffffff, #f9fafb);
        border-radius: 20px;
        padding: 20px 24px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.10);
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 14px;
        width: fit-content;
    }

        .filter-card input[type="date"] {
            border-radius: 14px;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            font-size: 0.9rem;
        }

    .stat-card {
        border-radius: 22px;
        padding: 20px;
        box-shadow: 0 14px 34px rgba(0,0,0,0.12);
        margin-bottom: 22px;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 44px rgba(0,0,0,0.18);
        }

    .stat-title {
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        opacity: 0.9;
        margin-bottom: 6px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 900;
    }

    .stat-ticket {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #ffffff;
    }

    .stat-snack {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #111827;
    }

    .stat-total {
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
        color: #ffffff;
    }

    .stat-seats {
        background: linear-gradient(135deg, #111827, #374151);
        color: #ffffff;
    }

    .table-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 26px;
        box-shadow: 0 14px 36px rgba(0,0,0,0.12);
    }

    table {
        font-size: 0.95rem;
    }

    thead th {
        font-weight: 800;
        text-align: center;
        padding: 16px;
        border-bottom: none;
        background: #111827;
        color: #ffffff;
    }

    tbody td {
        text-align: center;
        vertical-align: middle;
        padding: 14px;
    }

    tbody tr {
        transition: background-color 0.2s ease;
    }

        tbody tr:hover {
            background-color: #f9fafb;
        }

    .progress {
        height: 22px;
        border-radius: 14px;
        background-color: #e5e7eb;
    }

    .progress-bar {
        font-weight: 800;
        font-size: 0.75rem;
    }
</style>

<h2 class="page-title">Company Reports</h2>
<p class="page-sub">Daily revenue insights and showtime occupancy overview</p>

@* Date-based report filter *@
<form method="get">
    <div class="filter-card">
        <input type="date"
               name="date"
               value="@ViewBag.Date.ToString("yyyy-MM-dd")" /> @* Selected report date *@
        <button class="btn btn-primary">
            Show Report
        </button>
    </div>
</form>

<div class="row">

    <div class="col-md-3">
        <div class="stat-card stat-ticket">
            <div class="stat-title">Ticket Revenue</div>
            <div class="stat-value">@ViewBag.TicketRevenue ₺</div> @* Total ticket revenue *@
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card stat-snack">
            <div class="stat-title">Snack Revenue</div>
            <div class="stat-value">@ViewBag.SnackRevenue ₺</div> @* Total snack revenue *@
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card stat-total">
            <div class="stat-title">Total Revenue</div>
            <div class="stat-value">@ViewBag.TotalRevenue ₺</div> @* Combined daily revenue *@
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card stat-seats">
            <div class="stat-title">Sold Seats</div>
            <div class="stat-value">@ViewBag.SoldSeats</div> @* Total number of sold seats *@
        </div>
    </div>

</div>

<hr class="my-4" />

<h4 class="mb-3 fw-bold">Showtime Occupancy</h4>

<div class="table-card">
    <table class="table table-bordered table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Showtime ID</th>
                <th>Sold</th>
                <th>Total</th>
                <th>Occupancy</th>
            </tr>
        </thead>
        <tbody>
            @* Iterates through occupancy statistics per showtime *@
            @foreach (var o in ViewBag.Occupancies)
            {
                @* Calculates occupancy rate percentage *@
                var rate = o.Total == 0 ? 0 : (o.Sold * 100 / o.Total);

                <tr>
                    <td>@o.ShowtimeId</td>
                    <td>@o.Sold</td>
                    <td>@o.Total</td>
                    <td>
                        <div class="progress">
                            <div class="progress-bar
                                @(rate < 40 ? "bg-success" :
                                  rate < 70 ? "bg-warning" :
                                              "bg-danger")"
                                 style="width:@rate%">
                                %@rate @* Displays occupancy percentage *@
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>




