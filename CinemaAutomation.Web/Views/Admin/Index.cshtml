@{
    ViewData["Title"] = "Admin Panel"; // Sets the page title
}

<style>
    .admin-title {
        font-weight: 600;
        color: #1f2933;
        margin-bottom: 30px;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
    }

    .admin-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        text-decoration: none;
        color: #1f2933;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }

        .admin-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(0,0,0,0.15);
            color: #1f2933;
        }

    .admin-icon {
        font-size: 2.2rem;
        margin-bottom: 12px;
    }

    .admin-text {
        font-size: 1.05rem;
        font-weight: 500;
    }

    .admin-sub {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 6px;
    }
</style>

<h2 class="admin-title">Admin Dashboard</h2>

<div class="admin-grid">

    @* Navigates to user management module *@
    <a asp-controller="AdminUsers"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">👤</div>
        <div class="admin-text">Manage Users</div>
        <div class="admin-sub">Create, edit and remove users</div>
    </a>

    @* Navigates to movie management module *@
    <a asp-controller="Movies"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">🎬</div>
        <div class="admin-text">Manage Movies</div>
        <div class="admin-sub">Add and update movie details</div>
    </a>

    @* Navigates to hall and seating management *@
    <a asp-controller="Halls"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">🏛</div>
        <div class="admin-text">Manage Halls</div>
        <div class="admin-sub">Cinema halls and seating</div>
    </a>

    @* Navigates to showtime scheduling *@
    <a asp-controller="Showtimes"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">⏰</div>
        <div class="admin-text">Manage Showtimes</div>
        <div class="admin-sub">Session scheduling</div>
    </a>

    @* Navigates to snack and stock management *@
    <a asp-controller="Snacks"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">🍿</div>
        <div class="admin-text">Manage Snacks</div>
        <div class="admin-sub">Buffet & stock tracking</div>
    </a>

    @* Navigates to reporting and analytics module *@
    <a asp-controller="Reports"
       asp-action="Index"
       class="admin-card">
        <div class="admin-icon">📊</div>
        <div class="admin-text">Reports</div>
        <div class="admin-sub">Sales & activity reports</div>
    </a>

</div>


