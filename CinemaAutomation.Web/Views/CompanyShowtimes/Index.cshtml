<h2 class="page-title">My Showtimes</h2>

<style>
    .page-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 16px;
        letter-spacing: 0.3px;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 18px;
    }

    .create-btn {
        border-radius: 14px;
        padding: 10px 22px;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(0,0,0,0.15);
    }

    .table-card {
        background: #ffffff;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 14px 36px rgba(0,0,0,0.12);
    }

    table {
        font-size: 0.95rem;
    }

    thead th {
        background: #111827 !important;
        color: #ffffff;
        font-weight: 800;
        text-align: center;
        padding: 14px;
        border-bottom: none;
        white-space: nowrap;
    }

    tbody td {
        text-align: center;
        vertical-align: middle;
        padding: 14px;
    }

    tbody tr {
        transition: background-color 0.2s ease;
    }

        tbody tr:hover {
            background-color: #f9fafb;
        }

    .movie-name {
        font-weight: 700;
        color: #2563eb;
    }

    .hall-name {
        font-weight: 600;
        color: #374151;
    }

    .price-text {
        font-weight: 700;
        color: #16a34a;
    }

    .badge {
        border-radius: 12px;
        padding: 6px 12px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .progress {
        height: 20px;
        border-radius: 14px;
        background-color: #e5e7eb;
    }

    .progress-bar {
        font-weight: 800;
        font-size: 0.75rem;
    }

    .action-btn {
        border-radius: 12px;
        padding: 6px 14px;
        font-weight: 600;
        margin: 2px;
    }
</style>

<div class="action-bar">
    @* Navigates to showtime creation page *@
    <a asp-action="Create" class="btn btn-primary create-btn">
        + Create New Showtime
    </a>
</div>

<div class="table-card">
    <table class="table table-striped table-bordered table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Hall</th>
                <th>Start Time</th>
                <th>Price</th>
                <th>Status</th>
                <th>Occupancy</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @* Iterates through showtimes provided by the controller *@
            @foreach (var s in Model)
            {
                <tr>
                    <td class="movie-name">
                        @* Resolves movie name from dictionary by MovieId *@
                        @(ViewBag.MovieNames.ContainsKey(s.MovieId)
                            ? ViewBag.MovieNames[s.MovieId]
                            : "Unknown")
                    </td>

                    <td class="hall-name">
                        @* Resolves hall name from dictionary by HallId *@
                        @(ViewBag.HallNames.ContainsKey(s.HallId)
                            ? ViewBag.HallNames[s.HallId]
                            : "Unknown")
                    </td>

                    <td>@s.StartTime</td> @* Displays showtime start date/time *@

                    <td class="price-text">
                        @s.TicketBasePrice ₺ @* Base ticket price *@
                    </td>

                    <td>
                        @* Displays active/passive status *@
                        @if (s.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Passive</span>
                        }
                    </td>

                    <td style="width:180px">
                        @{
                            @* Retrieves occupancy rate for this showtime *@
                            var rate = ViewBag.OccupancyRates[s.ShowtimeId];
                        }

                        <div class="progress">
                            <div class="progress-bar
                                @(rate < 40 ? "bg-success" :
                                  rate < 70 ? "bg-warning" :
                                              "bg-danger")"
                                 role="progressbar"
                                 style="width:@rate%">
                                %@rate @* Occupancy percentage *@
                            </div>
                        </div>
                    </td>

                    <td>
                        @* Navigates to edit showtime *@
                        <a asp-action="Edit"
                           asp-route-id="@s.ShowtimeId"
                           class="btn btn-warning btn-sm action-btn">
                            Edit
                        </a>

                        @* Posts request to deactivate showtime *@
                        <form asp-action="Delete"
                              asp-route-id="@s.ShowtimeId"
                              method="post"
                              style="display:inline">
                            <button type="submit"
                                    class="btn btn-danger btn-sm action-btn">
                                Deactivate
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>





