@model CinemaAutomation.Web.Data.Entities.Showtime
@* View model representing a showtime entity *@

@{
    ViewData["Title"] = "Create Showtime"; // Sets the page title
}

<style>
    .page-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
        text-align: center;
    }

    .page-sub {
        color: #6b7280;
        margin-bottom: 28px;
        font-size: 0.95rem;
        text-align: center;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
    }

    .form-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        width: 100%;
        max-width: 520px;
    }

    label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 14px;
        padding: 10px 14px;
        font-size: 0.95rem;
    }

        .form-control:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 0.2rem rgba(34, 197, 94, 0.25);
        }

    .save-btn {
        border-radius: 18px;
        padding: 14px 32px;
        font-weight: 800;
        font-size: 0.95rem;
        width: 100%;
        margin-top: 14px;
        border: none;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #ffffff;
        letter-spacing: 0.4px;
        transition: all 0.25s ease;
    }

        .save-btn:hover {
            background: linear-gradient(135deg, #16a34a, #15803d);
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(34, 197, 94, 0.45);
        }

        .save-btn:active {
            transform: translateY(0);
            box-shadow: 0 8px 18px rgba(34, 197, 94, 0.35);
        }

        .save-btn:focus {
            outline: none;
            box-shadow: 0 0 0 0.25rem rgba(34, 197, 94, 0.35);
        }
</style>

<h2 class="page-title">Create Showtime</h2>
<p class="page-sub">Define movie, hall, time and ticket price</p>

<div class="form-wrapper">
    <div class="form-card">

        @* Form submits new showtime data to Create action *@
        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label>Movie</label>
                <select asp-for="MovieId"
                        asp-items="ViewBag.Movies"
                        class="form-control">
                </select> @* Binds selected movie ID *@
            </div>

            <div class="mb-3">
                <label>Hall</label>
                <select asp-for="HallId"
                        asp-items="ViewBag.Halls"
                        class="form-control">
                </select> @* Binds selected hall ID *@
            </div>

            <div class="mb-3">
                <label>Start Time</label>
                <input asp-for="StartTime"
                       type="datetime-local"
                       class="form-control" /> @* Binds showtime start date/time *@
            </div>

            <div class="mb-3">
                <label>Ticket Price</label>
                <input asp-for="TicketBasePrice"
                       class="form-control" /> @* Binds base ticket price *@
            </div>

            <button type="submit" class="save-btn">
                Save Showtime
            </button>

        </form>

    </div>
</div>

