@model IEnumerable<CinemaAutomation.Web.Data.Entities.Seat>
@* View model: list of seats for the selected showtime *@

@{
    var showtime = ViewBag.Showtime; // Showtime information passed from controller
    ViewData["Title"] = "Select Seats"; // Sets the page title
}

<style>
    .page-title {
        font-weight: 800;
        color: #1f2933;
        margin-bottom: 10px;
        text-align: center;
    }

    .page-sub {
        color: #6c757d;
        margin-bottom: 18px;
        font-size: 0.95rem;
        text-align: center;
    }

    .price-pill {
        display: inline-block;
        background: linear-gradient(90deg, #0d6efd, #4dabf7);
        color: #fff;
        border-radius: 20px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .page-center {
        display: flex;
        justify-content: center;
    }

    .seat-wrapper {
        background: #ffffff;
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 14px 34px rgba(0,0,0,0.12);
        width: fit-content;
    }

    table {
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    thead th {
        background: #f1f3f5;
        font-weight: 700;
        text-align: center;
        padding: 14px;
        border-bottom: none;
    }

    tbody td {
        text-align: center;
        vertical-align: middle;
        padding: 12px;
    }

    tbody tr {
        transition: all 0.2s ease;
    }

        tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
        }

    /* SOLD SEATS */
    .sold-row {
        background-color: #fde2e2 !important;
        opacity: 0.85;
    }

        .sold-row td {
            text-decoration: line-through;
            color: #b02a37;
        }

    /* Controls */
    select {
        border-radius: 12px;
        padding: 6px 10px;
        font-size: 0.85rem;
    }

    input[type="checkbox"] {
        transform: scale(1.3);
        cursor: pointer;
    }

    .legend {
        margin-top: 18px;
        font-size: 0.85rem;
        color: #495057;
        text-align: center;
    }

        .legend span {
            margin-right: 18px;
        }

    .legend-box {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
        margin-right: 6px;
        vertical-align: middle;
    }

    .legend-sold {
        background-color: #fde2e2;
    }

    .legend-available {
        background-color: #ffffff;
        border: 1px solid #adb5bd;
    }

    .continue-btn {
        margin-top: 26px;
        padding: 12px 36px;
        border-radius: 16px;
        font-weight: 700;
        font-size: 0.95rem;
        transition: all 0.25s ease;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

        .continue-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.18);
        }
</style>

<h2 class="page-title">Select Your Seats</h2>

<p class="page-sub">
    Showtime: <strong>@showtime.StartTime</strong> @* Displays showtime start date/time *@
</p>

<div class="page-sub">
    <strong>Base ticket price:</strong>
    <span class="price-pill">@showtime.TicketBasePrice ₺</span> @* Displays base ticket price *@
</div>

<form asp-controller="Booking" asp-action="Confirm" method="post">
    <input type="hidden" name="showtimeId" value="@showtime.ShowtimeId" /> @* Sends showtime id *@

    <div class="page-center">
        <div class="seat-wrapper">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Seat</th>
                        <th>Select</th>
                        <th>Ticket Type</th>
                    </tr>
                </thead>
                <tbody>
                    @* Iterates through all seats in the hall *@
                    @foreach (var seat in Model)
                    {
                        @* Checks if the seat is already sold for this showtime *@
                        bool isSold = seat.ShowtimeSeats != null &&
                        seat.ShowtimeSeats.Any(s =>
                        s.ShowtimeId == showtime.ShowtimeId &&
                        s.Status == "Sold");

                        <tr class="@(isSold ? "sold-row" : "")">
                            <td>@seat.RowNumber</td>
                            <td>@seat.SeatNumber</td>
                            <td>
                                <input type="checkbox"
                                       name="SeatIds"
                                       value="@seat.SeatId"
                                @(isSold ? "disabled" : "") /> @* Disabled if seat is sold *@
                            </td>
                            <td>
                                <select name="TicketTypes[@seat.SeatId]"
                                @(isSold ? "disabled" : "")> @* Ticket type per seat *@
                                    <option value="Full">Full</option>
                                    <option value="Student">Student</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="legend">
        <span>
            <span class="legend-box legend-available"></span>
            Available
        </span>
        <span>
            <span class="legend-box legend-sold"></span>
            Sold
        </span>
    </div>

    <button type="submit" class="btn btn-success continue-btn">
        Continue to Checkout
    </button>
</form>






