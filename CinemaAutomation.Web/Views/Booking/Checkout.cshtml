@model CinemaAutomation.Web.ViewModels.CheckoutViewModel
@* View model containing checkout items, pricing and showtime info *@

@{
    ViewData["Title"] = "Checkout"; // Sets the page title
}

<style>
    .checkout-title {
        font-weight: 700;
        color: #1f2933;
        margin-bottom: 28px;
        letter-spacing: 0.3px;
    }

    .checkout-card {
        background: linear-gradient(180deg, #ffffff, #fbfbfc);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 12px 28px rgba(0,0,0,0.10);
    }

    .info-row {
        font-size: 0.95rem;
        color: #495057;
        margin-bottom: 18px;
    }

        .info-row strong {
            color: #1f2933;
        }

    table {
        margin-top: 14px;
        font-size: 0.95rem;
    }

    thead {
        background: linear-gradient(90deg, #e9ecef, #f8f9fa);
    }

        thead th {
            font-weight: 600;
            color: #495057;
            border-bottom: none;
            text-align: center;
            padding: 14px;
        }

    tbody td {
        text-align: center;
        vertical-align: middle;
        padding: 14px;
    }

    tbody tr {
        transition: background-color 0.2s ease;
    }

        tbody tr:hover {
            background-color: #f1f3f5;
        }

    /* Seat badge look */
    .seat-badge {
        display: inline-block;
        background-color: #e3f2fd;
        color: #0d6efd;
        border-radius: 20px;
        padding: 6px 14px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .type-badge {
        display: inline-block;
        background-color: #f8f9fa;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.85rem;
        font-weight: 500;
        color: #495057;
    }

    .price-text {
        font-weight: 600;
        color: #198754;
    }

    .total-box {
        margin-top: 24px;
        background: linear-gradient(90deg, #1f2933, #343a40);
        color: #ffffff;
        border-radius: 16px;
        padding: 18px 22px;
        font-size: 1.15rem;
        font-weight: 700;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pay-btn {
        margin-top: 26px;
        border-radius: 14px;
        padding: 12px 32px;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.25s ease;
    }

        .pay-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.2);
        }
</style>

<h2 class="checkout-title">Checkout</h2>

<div class="checkout-card">

    <p class="info-row">
        <strong>Showtime:</strong> @Model.StartTime @* Displays selected showtime *@
    </p>

    <table class="table table-bordered table-hover align-middle">
        <thead>
            <tr>
                <th>Seat</th>
                <th>Type</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @* Iterates through checkout items (seat + ticket type + price) *@
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <span class="seat-badge">
                            @(ViewBag.SeatLabels[item.SeatId]) @* Maps seat ID to readable label *@
                        </span>
                    </td>
                    <td>
                        <span class="type-badge">
                            @item.TicketType @* Displays ticket type *@
                        </span>
                    </td>
                    <td>
                        <span class="price-text">
                            @item.Price ₺ @* Displays ticket price *@
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="total-box">
        <span>Total Amount</span>
        <span>@Model.Total ₺</span> @* Displays calculated total amount *@
    </div>

    @* Submits payment confirmation request *@
    <form asp-action="CompletePayment" method="post" class="text-end">
        <button class="btn btn-success pay-btn">
            Pay Securely
        </button>
    </form>

</div>





