@model CinemaAutomation.Web.Data.Entities.Hall
@* View model representing the hall being edited *@

@{
    ViewData["Title"] = "Edit Hall"; // Sets the page title
}

<style>
    .page-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 6px;
        letter-spacing: 0.3px;
        text-align: center;
    }

    .page-sub {
        color: #6b7280;
        margin-bottom: 32px;
        font-size: 0.95rem;
        text-align: center;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
    }

    .form-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        width: 100%;
        max-width: 540px;
    }

    h4, hr {
        display: none;
    }

    label.control-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-control {
        border-radius: 14px;
        padding: 10px 14px;
        font-size: 0.95rem;
    }

        .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
        }

    .form-check {
        margin-top: 8px;
        margin-bottom: 18px;
    }

    .form-check-label {
        font-weight: 600;
        color: #374151;
    }

    .save-btn {
        border-radius: 18px;
        padding: 14px 32px;
        font-weight: 800;
        font-size: 0.95rem;
        width: 100%;
        border: none;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #ffffff;
        letter-spacing: 0.4px;
        transition: all 0.25s ease;
    }

        .save-btn:hover {
            background: linear-gradient(135deg, #4f46e5, #4338ca);
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(79, 70, 229, 0.45);
        }

        .save-btn:active {
            transform: translateY(0);
            box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 18px;
        font-weight: 600;
        color: #2563eb;
        text-decoration: none;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>

<h2 class="page-title">Edit Hall</h2>
<p class="page-sub">Update hall information and seating layout</p>

<div class="form-wrapper">
    <div class="form-card">

        @* Form submits updated hall data to Edit action *@
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @* Displays model-level validation errors *@

            <input type="hidden" asp-for="HallId" />
            @* Sends hall ID for update operation *@

            <div class="form-group">
                <label asp-for="CompanyId" class="control-label"></label>
                <input asp-for="CompanyId" class="form-control" />
                <span asp-validation-for="CompanyId" class="text-danger"></span>
                @* Binds company identifier (usually fixed per hall) *@
            </div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
                @* Binds and validates hall name *@
            </div>

            <div class="form-group">
                <label asp-for="TotalRows" class="control-label"></label>
                <input asp-for="TotalRows" class="form-control" />
                <span asp-validation-for="TotalRows" class="text-danger"></span>
                @* Binds and validates number of seat rows *@
            </div>

            <div class="form-group">
                <label asp-for="TotalColumns" class="control-label"></label>
                <input asp-for="TotalColumns" class="form-control" />
                <span asp-validation-for="TotalColumns" class="text-danger"></span>
                @* Binds and validates number of seats per row *@
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" />
                    @Html.DisplayNameFor(model => model.IsActive)
                </label>
                @* Sets hall active/passive status *@
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save Changes"
                       class="save-btn" />
                @* Submits hall update form *@
            </div>
        </form>

    </div>
</div>

@* Navigates back to hall list *@
<a asp-action="Index" class="back-link">
    ← Back to Hall List
</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Enables client-side validation scripts *@
}

