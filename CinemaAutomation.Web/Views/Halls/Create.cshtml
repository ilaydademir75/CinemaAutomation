@model CinemaAutomation.Web.Data.Entities.Hall
@* View model representing a cinema hall entity *@

@{
    ViewData["Title"] = "Create Hall"; // Sets the page title
}

<style>
    .page-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 6px;
        letter-spacing: 0.3px;
        text-align: center;
    }

    .page-sub {
        color: #6b7280;
        margin-bottom: 32px;
        font-size: 0.95rem;
        text-align: center;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
    }

    .form-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        width: 100%;
        max-width: 520px;
    }

    h4 {
        display: none;
    }

    hr {
        display: none;
    }

    label.control-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 14px;
        padding: 10px 14px;
        font-size: 0.95rem;
    }

    .form-control:focus {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 0.2rem rgba(14, 165, 233, 0.25);
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-check {
        margin-top: 10px;
        margin-bottom: 18px;
    }

    .form-check-label {
        font-weight: 600;
        color: #374151;
    }

    .create-btn {
        border-radius: 18px;
        padding: 14px 32px;
        font-weight: 800;
        font-size: 0.95rem;
        width: 100%;
        border: none;
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        color: #ffffff;
        letter-spacing: 0.4px;
        transition: all 0.25s ease;
    }

    .create-btn:hover {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(14, 165, 233, 0.45);
    }

    .create-btn:active {
        transform: translateY(0);
        box-shadow: 0 8px 18px rgba(14, 165, 233, 0.35);
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 18px;
        font-weight: 600;
        color: #2563eb;
        text-decoration: none;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

<h2 class="page-title">Create Hall</h2>
<p class="page-sub">Define hall name, seating layout and status</p>

<div class="form-wrapper">
    <div class="form-card">

        @* Form submits new hall data to Create action *@
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @* Displays model-level validation errors *@

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
                @* Binds and validates hall name *@
            </div>

            <div class="form-group">
                <label asp-for="TotalRows" class="control-label"></label>
                <input asp-for="TotalRows" class="form-control" />
                <span asp-validation-for="TotalRows" class="text-danger"></span>
                @* Binds and validates number of rows *@
            </div>

            <div class="form-group">
                <label asp-for="TotalColumns" class="control-label"></label>
                <input asp-for="TotalColumns" class="form-control" />
                <span asp-validation-for="TotalColumns" class="text-danger"></span>
                @* Binds and validates number of columns (seats per row) *@
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" />
                    @Html.DisplayNameFor(model => model.IsActive)
                </label>
                @* Sets hall active/passive status *@
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Create Hall"
                       class="create-btn" />
                @* Submits hall creation form *@
            </div>
        </form>

    </div>
</div>

@* Navigates back to hall list *@
<a asp-action="Index" class="back-link">
    ← Back to Hall List
</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Enables client-side validation scripts *@
}

