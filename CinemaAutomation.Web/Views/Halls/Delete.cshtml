@model CinemaAutomation.Web.Data.Entities.Hall
@* View model representing the hall to be deleted *@

@{
    ViewData["Title"] = "Delete Hall"; // Sets the page title
}

<style>
    .page-title {
        font-weight: 800;
        color: #7f1d1d;
        margin-bottom: 6px;
        letter-spacing: 0.3px;
        text-align: center;
    }

    .page-sub {
        color: #6b7280;
        margin-bottom: 28px;
        font-size: 0.95rem;
        text-align: center;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
    }

    .delete-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        max-width: 560px;
        width: 100%;
    }

    .warning-box {
        background: #fef2f2;
        border-left: 6px solid #dc2626;
        border-radius: 14px;
        padding: 14px 18px;
        color: #7f1d1d;
        font-weight: 600;
        margin-bottom: 22px;
        text-align: center;
    }

    dl.row dt {
        font-weight: 700;
        color: #374151;
    }

    dl.row dd {
        color: #111827;
        margin-bottom: 10px;
    }

    .action-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 26px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .delete-btn {
        border-radius: 18px;
        padding: 12px 30px;
        font-weight: 800;
        font-size: 0.95rem;
        border: none;
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: #ffffff;
        letter-spacing: 0.4px;
        transition: all 0.25s ease;
    }

        .delete-btn:hover {
            background: linear-gradient(135deg, #b91c1c, #991b1b);
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(220, 38, 38, 0.45);
        }

        .delete-btn:active {
            transform: translateY(0);
            box-shadow: 0 8px 18px rgba(220, 38, 38, 0.35);
        }

    .back-link {
        font-weight: 600;
        color: #2563eb;
        text-decoration: none;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>

<h2 class="page-title">Delete Hall</h2>
<p class="page-sub">This action cannot be undone</p>

<div class="form-wrapper">
    <div class="delete-card">

        <div class="warning-box">
            Are you sure you want to permanently delete this hall?
        </div>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.CompanyId)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.CompanyId)
            </dd>
            @* Displays company identifier for the hall *@

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Name)
            </dd>
            @* Displays hall name *@

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.TotalRows)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TotalRows)
            </dd>
            @* Displays number of seat rows *@

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.TotalColumns)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TotalColumns)
            </dd>
            @* Displays number of seats per row *@

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.IsActive)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.IsActive)
            </dd>
            @* Displays hall active/passive status *@
        </dl>

        @* Form submits delete confirmation to Delete action *@
        <form asp-action="Delete">
            <input type="hidden" asp-for="HallId" />
            @* Sends hall ID for deletion *@

            <div class="action-row">
                <input type="submit"
                       value="Delete Hall"
                       class="delete-btn" />
                @* Confirms hall deletion *@

                <a asp-action="Index" class="back-link">
                    Cancel and go back
                </a>
                @* Navigates back to hall list without deleting *@
            </div>
        </form>

    </div>
</div>

