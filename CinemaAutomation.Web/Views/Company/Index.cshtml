@{
    ViewData["Title"] = "Company Panel"; // Sets the page title
}

<style>
    .company-title {
        font-weight: 800;
        color: #1f2933;
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }

    .company-sub {
        color: #6c757d;
        margin-bottom: 22px;
        font-size: 0.95rem;
    }

    .company-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
        margin-top: 16px;
    }

    .company-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 22px;
        text-decoration: none;
        color: #1f2933;
        box-shadow: 0 10px 26px rgba(0,0,0,0.10);
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .company-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 34px rgba(0,0,0,0.16);
            color: #1f2933;
        }

    .company-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 700;
        background: #f1f3f5;
    }

    .company-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .company-main {
        font-weight: 700;
        font-size: 1.02rem;
    }

    .company-desc {
        color: #6c757d;
        font-size: 0.88rem;
    }

    /* Keep original list-group structure compatible */
    .list-group {
        background: transparent;
    }

    .list-group-item {
        border: none;
        padding: 0;
        background: transparent;
    }
</style>

<h2 class="company-title">Company Dashboard</h2>
<p class="company-sub">Manage your halls, showtimes and sales reports from one place.</p>

<div class="list-group mt-3">
    <div class="company-grid">

        @* Navigates to company's hall management *@
        <a asp-controller="CompanyHalls" asp-action="Index"
           class="list-group-item list-group-item-action company-card">
            <div class="company-icon">🏛</div>
            <div class="company-text">
                <div class="company-main">My Halls</div>
                <div class="company-desc">View and manage your cinema halls</div>
            </div>
        </a>

        @* Navigates to company's showtime management *@
        <a asp-controller="CompanyShowtimes" asp-action="Index"
           class="list-group-item list-group-item-action company-card">
            <div class="company-icon">⏰</div>
            <div class="company-text">
                <div class="company-main">My Showtimes</div>
                <div class="company-desc">Create and manage showtime schedules</div>
            </div>
        </a>

        @* Navigates to company's sales and revenue reports *@
        <a asp-controller="CompanyReports" asp-action="Index"
           class="list-group-item list-group-item-action company-card">
            <div class="company-icon">📈</div>
            <div class="company-text">
                <div class="company-main">Sales Reports</div>
                <div class="company-desc">Track revenue and sales performance</div>
            </div>
        </a>

    </div>
</div>


