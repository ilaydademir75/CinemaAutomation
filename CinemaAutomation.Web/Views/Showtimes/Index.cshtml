@model IEnumerable<CinemaAutomation.Web.Data.Entities.Showtime>

@{
    Layout = null; @* Standalone layout for showtimes page *@
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Showtimes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> <!-- Bootstrap CSS -->

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #f9fafb, #f3f4f6);
            font-family: 'Segoe UI', Tahoma, sans-serif;
            padding: 30px;
        }

        .page-title {
            font-weight: 900;
            color: #111827;
            margin-bottom: 18px;
            letter-spacing: 0.4px;
        }

        .action-bar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }

        .create-btn {
            border-radius: 16px;
            padding: 10px 22px;
            font-weight: 800;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: #ffffff;
            text-decoration: none;
            transition: all 0.25s ease;
        }

            .create-btn:hover {
                background: linear-gradient(135deg, #4f46e5, #4338ca);
                transform: translateY(-2px);
                box-shadow: 0 12px 26px rgba(79, 70, 229, 0.45);
                color: #ffffff;
            }

        .table-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        }

        thead th {
            background: #111827 !important;
            color: #ffffff;
            font-weight: 800;
            padding: 14px;
            text-align: center;
            white-space: nowrap;
        }

        tbody td {
            text-align: center;
            vertical-align: middle;
            padding: 14px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .status-active {
            background-color: #dcfce7;
            color: #166534;
        }

        .status-passive {
            background-color: #e5e7eb;
            color: #374151;
        }

        .action-links a {
            margin: 0 4px;
            font-weight: 600;
            text-decoration: none;
        }

        .link-edit {
            color: #6366f1;
        }

        .link-details {
            color: #16a34a;
        }

        .link-delete {
            color: #dc2626;
        }
    </style>
</head>

<body>

    <!-- Page title -->
    <h2 class="page-title">Showtimes</h2>

    <!-- Create new showtime button -->
    <div class="action-bar">
        <a asp-action="Create" class="create-btn">
            + Create New Showtime
        </a>
    </div>

    <div class="table-card">
        <table class="table table-bordered table-hover align-middle mb-0">
            <!-- Table header -->
            <thead>
                <tr>
                    <th>Movie</th>
                    <th>Hall</th>
                    <th>Start Time</th>
                    <th>Ticket Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <!-- Showtime list -->
            <tbody>
                @foreach (var item in Model) @* Loop through showtimes *@
                {
                    <tr>
                        <td>
                            @item.Movie.Title @* Related movie title *@
                        </td>

                        <td>
                            @item.Hall.Name @* Related hall name *@
                        </td>

                        <td>
                            @item.StartTime.ToString("dd.MM.yyyy HH:mm") @* Formatted start time *@
                        </td>

                        <td>
                            @item.TicketBasePrice ₺ @* Base ticket price *@
                        </td>

                        <td>
                            @if (item.IsActive) @* Showtime status *@
                            {
                                <span class="status-badge status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-passive">Passive</span>
                            }
                        </td>

                        <td class="action-links">
                            <a asp-action="Edit"
                               asp-route-id="@item.ShowtimeId"
                               class="link-edit">
                                Edit
                            </a> |
                            <a asp-action="Details"
                               asp-route-id="@item.ShowtimeId"
                               class="link-details">
                                Details
                            </a> |
                            <a asp-action="Delete"
                               asp-route-id="@item.ShowtimeId"
                               class="link-delete">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>


