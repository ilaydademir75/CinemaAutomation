@model CinemaAutomation.Web.Data.Entities.Showtime
@* View model used to create a new showtime *@

@{
    ViewData["Title"] = "Create Showtime"; // Sets page title
}

<style>
    .page-title {
        font-weight: 800;
        text-align: center;
        margin-bottom: 8px;
    }

    .page-sub {
        text-align: center;
        color: #6b7280;
        margin-bottom: 24px;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
    }

    .form-card {
        background: #fff;
        padding: 32px;
        border-radius: 22px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 16px 40px rgba(0,0,0,.12);
    }

    .submit-btn {
        width: 100%;
        padding: 14px;
        border-radius: 18px;
        border: none;
        font-weight: 700;
        background: linear-gradient(135deg,#6366f1,#4f46e5);
        color: white;
        margin-top: 14px;
    }
</style>

<h2 class="page-title">Create Showtime</h2>
<p class="page-sub">Schedule a new movie screening</p>

<div class="form-wrapper">
    <div class="form-card">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @* Protects the form against CSRF attacks *@

            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            @* Displays validation errors from the server *@

            <div class="mb-3">
                <label>Movie</label>
                <select id="MovieSelect"
                        class="form-control"
                        asp-items="ViewBag.Movies">
                </select>
                @* Dropdown populated with movies from controller *@
                <input type="hidden" name="MovieId" id="MovieId" />
                @* Hidden field used for model binding *@
            </div>

            <div class="mb-3">
                <label>Hall</label>
                <select id="HallSelect"
                        class="form-control"
                        asp-items="ViewBag.Halls">
                </select>
                @* Dropdown populated with halls from controller *@
                <input type="hidden" name="HallId" id="HallId" />
                @* Hidden field used for model binding *@
            </div>

            <div class="mb-3">
                <label>Start Time</label>
                <input type="datetime-local"
                       name="StartTime"
                       class="form-control"
                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                @* Sets default start time to current date and time *@
            </div>

            <div class="mb-3">
                <label>Ticket Price</label>
                <input type="text"
                       name="TicketBasePrice"
                       class="form-control"
                       placeholder="Örn: 100,00" />
                @* Base ticket price for the showtime *@
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input"
                       type="checkbox"
                       name="IsActive"
                       value="true"
                       checked />
                <label class="form-check-label">
                    Active
                </label>
                @* Indicates whether the showtime is active *@
            </div>

            <button type="submit" class="submit-btn">
                Create Showtime
            </button>
            @* Submits showtime creation form *@

            <div class="text-center mt-3">
                <a asp-action="Index">← Back to Showtimes</a>
                @* Navigates back to showtime list *@
            </div>
        </form>

    </div>
</div>

<script>
    const movieSelect = document.getElementById("MovieSelect");
    const hallSelect = document.getElementById("HallSelect");

    const movieHidden = document.getElementById("MovieId");
    const hallHidden = document.getElementById("HallId");

    // Initialize hidden inputs on page load
    movieHidden.value = movieSelect.value;
    hallHidden.value = hallSelect.value;

    // Sync selected movie with hidden MovieId field
    movieSelect.addEventListener("change", () => {
        movieHidden.value = movieSelect.value;
    });

    // Sync selected hall with hidden HallId field
    hallSelect.addEventListener("change", () => {
        hallHidden.value = hallSelect.value;
    });
</script>


