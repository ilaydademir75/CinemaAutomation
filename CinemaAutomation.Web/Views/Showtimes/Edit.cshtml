@model CinemaAutomation.Web.Data.Entities.Showtime
@using System.Globalization

@{
    Layout = null; // Standalone layout (no shared layout)
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Showtime</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> <!-- Bootstrap base styles -->

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #f9fafb, #f3f4f6);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        .form-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 32px 36px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.14);
            width: 100%;
            max-width: 520px;
        }

        h4 {
            font-weight: 900;
            text-align: center;
            color: #111827;
            margin-bottom: 6px;
            letter-spacing: 0.4px;
        }

        .subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 0.9rem;
            margin-bottom: 26px;
        }

        hr {
            display: none;
        }

        label.control-label,
        label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 6px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-control {
            border-radius: 14px;
            padding: 10px 14px;
            font-size: 0.95rem;
        }

            .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
            }

        .form-check {
            margin-top: 6px;
            margin-bottom: 20px;
        }

        .form-check-label {
            font-weight: 600;
            color: #374151;
        }

        .save-btn {
            width: 100%;
            border-radius: 18px;
            padding: 14px;
            font-weight: 800;
            font-size: 0.95rem;
            border: none;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: #ffffff;
            letter-spacing: 0.4px;
            transition: all 0.25s ease;
        }

            .save-btn:hover {
                background: linear-gradient(135deg, #4f46e5, #4338ca);
                transform: translateY(-2px);
                box-shadow: 0 14px 30px rgba(79, 70, 229, 0.45);
            }

            .save-btn:active {
                transform: translateY(0);
                box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 18px;
            font-weight: 600;
            color: #2563eb;
            text-decoration: none;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="form-card">
        <h4>Edit Showtime</h4>
        <div class="subtitle">
            Update screening schedule and availability
        </div>

        @* Edit form for an existing showtime *@
        <form asp-action="Edit"
              asp-route-id="@Model.ShowtimeId"
              method="post">

            @Html.AntiForgeryToken() @* CSRF protection *@

            @* Validation error summary *@
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            @* Hidden primary keys (must be preserved during update) *@
            <input type="hidden" asp-for="ShowtimeId" />
            <input type="hidden" asp-for="MovieId" />
            <input type="hidden" asp-for="HallId" />

            @* Display movie (read-only) *@
            <div class="form-group">
                <label>Movie</label>
                <input class="form-control" value="@Model.MovieId" readonly />
            </div>

            @* Display hall (read-only) *@
            <div class="form-group">
                <label>Hall</label>
                <input class="form-control" value="@Model.HallId" readonly />
            </div>

            @* Editable start time *@
            <div class="form-group">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime"
                       type="datetime-local"
                       class="form-control"
                       value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            @* Editable base ticket price (culture-invariant) *@
            <div class="form-group">
                <label asp-for="TicketBasePrice" class="control-label"></label>
                <input asp-for="TicketBasePrice"
                       type="number"
                       step="0.01"
                       class="form-control"
                       value="@Model.TicketBasePrice.ToString(CultureInfo.InvariantCulture)" />
                <span asp-validation-for="TicketBasePrice" class="text-danger"></span>
            </div>

            @* Active / passive status *@
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" />
                    Active
                </label>
            </div>

            <button type="submit" class="save-btn">Save Changes</button>
        </form>

        @* Back navigation *@
        <a asp-action="Index" class="back-link">
            ← Back to Showtimes
        </a>
    </div>

</body>
</html>

