@model CinemaAutomation.Web.Data.Entities.Showtime
@* View model representing the showtime to be deleted *@

@{
    Layout = null;
}
@* Disables the shared layout for a standalone confirmation page *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Showtime</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Loads Bootstrap styles for layout and components *@

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #f9fafb, #f3f4f6);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, sans-serif;
        }

        .delete-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 32px 36px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.14);
            max-width: 620px;
            width: 100%;
        }

        .page-title {
            font-weight: 900;
            color: #7f1d1d;
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: 0.4px;
        }

        .page-sub {
            text-align: center;
            color: #6b7280;
            font-size: 0.9rem;
            margin-bottom: 24px;
        }

        .warning-box {
            background: #fef2f2;
            border-left: 6px solid #dc2626;
            border-radius: 14px;
            padding: 14px 18px;
            color: #7f1d1d;
            font-weight: 700;
            text-align: center;
            margin-bottom: 26px;
        }

        dl.row dt {
            font-weight: 700;
            color: #374151;
        }

        dl.row dd {
            color: #111827;
            margin-bottom: 10px;
        }

        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 28px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .delete-btn {
            border-radius: 18px;
            padding: 12px 30px;
            font-weight: 800;
            font-size: 0.95rem;
            border: none;
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: #ffffff;
            letter-spacing: 0.4px;
            transition: all 0.25s ease;
        }

            .delete-btn:hover {
                background: linear-gradient(135deg, #b91c1c, #991b1b);
                transform: translateY(-2px);
                box-shadow: 0 14px 30px rgba(220, 38, 38, 0.45);
            }

            .delete-btn:active {
                transform: translateY(0);
                box-shadow: 0 8px 18px rgba(220, 38, 38, 0.35);
            }

        .back-link {
            font-weight: 600;
            color: #2563eb;
            text-decoration: none;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="delete-card">

        <h3 class="page-title">Delete Showtime</h3>
        <div class="page-sub">
            This action cannot be undone
        </div>

        <div class="warning-box">
            Are you sure you want to permanently delete this showtime?
        </div>

        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MovieId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.MovieId)</dd>
            @* Displays associated movie identifier *@

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HallId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.HallId)</dd>
            @* Displays associated hall identifier *@

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StartTime)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.StartTime)</dd>
            @* Displays showtime start date and time *@

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TicketBasePrice)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.TicketBasePrice)</dd>
            @* Displays base ticket price *@

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsActive)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.IsActive)</dd>
            @* Displays showtime active/passive status *@
        </dl>

        <form asp-action="Delete">
            @* Submits delete confirmation to Delete action *@
            <input type="hidden" asp-for="ShowtimeId" />
            @* Sends showtime ID required for deletion *@

            <div class="action-row">
                <input type="submit"
                       value="Delete Showtime"
                       class="delete-btn" />
                @* Confirms permanent deletion *@

                <a asp-action="Index" class="back-link">
                    Cancel and go back
                </a>
                @* Navigates back to showtime list without deleting *@
            </div>
        </form>

    </div>

</body>
</html>

