@model IEnumerable<CinemaAutomation.Web.Data.Entities.Snack>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Snacks</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />  <!-- Bootstrap CSS -->

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #fff7ed, #ffedd5);
            font-family: 'Segoe UI', Tahoma, sans-serif;
            padding: 30px;
        }

        .page-title {
            font-weight: 900;
            color: #9a3412;
            margin-bottom: 16px;
            letter-spacing: 0.4px;
        }

        .action-bar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }

        .create-btn {
            border-radius: 18px;
            padding: 10px 22px;
            font-weight: 800;
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: #ffffff;
            text-decoration: none;
            transition: all 0.25s ease;
        }

            .create-btn:hover {
                background: linear-gradient(135deg, #ea580c, #c2410c);
                transform: translateY(-2px);
                box-shadow: 0 14px 28px rgba(234, 88, 12, 0.45);
                color: #ffffff;
            }

        .table-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.14);
        }

        table {
            font-size: 0.95rem;
        }

        thead th {
            background: #9a3412 !important;
            color: #ffffff;
            font-weight: 800;
            padding: 14px;
            text-align: center;
            border-bottom: none;
        }

        tbody td {
            text-align: center;
            vertical-align: middle;
            padding: 14px;
        }

        tbody tr {
            transition: background-color 0.2s ease;
        }

            tbody tr:hover {
                background-color: #fff7ed;
            }

        .price-badge {
            background-color: #dcfce7;
            color: #166534;
            padding: 6px 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .stock-badge {
            background-color: #e5e7eb;
            color: #374151;
            padding: 6px 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .status-active {
            background-color: #dcfce7;
            color: #166534;
            padding: 6px 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .status-passive {
            background-color: #e5e7eb;
            color: #374151;
            padding: 6px 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .action-links a {
            margin: 0 4px;
            font-weight: 700;
            text-decoration: none;
        }

        .link-edit {
            color: #f97316;
        }

        .link-details {
            color: #16a34a;
        }

        .link-delete {
            color: #dc2626;
        }

        .action-links a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <!-- Page title -->
    <h2 class="page-title">Snacks</h2>

    <!-- Top action bar: create new snack -->
    <div class="action-bar">
        <a asp-action="Create" class="create-btn">
            + Add New Snack
        </a>
    </div>

    <!-- Snacks list table -->
    <div class="table-card">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th> <!-- Snack name column -->
                    <th>@Html.DisplayNameFor(model => model.UnitPrice)</th> <!-- Unit price column -->
                    <th>@Html.DisplayNameFor(model => model.StockQuantity)</th> <!-- Stock quantity column -->
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th> <!-- Active / passive status column -->
                    <th>Actions</th> <!-- Action buttons column -->
                </tr>
            </thead>
            <tbody>
                @* Loop through snack list *@
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Snack name -->
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>

                        <!-- Snack price -->
                        <td>
                            <span class="price-badge">
                                @Html.DisplayFor(modelItem => item.UnitPrice) ₺
                            </span>
                        </td>

                        <!-- Stock quantity -->
                        <td>
                            <span class="stock-badge">
                                @Html.DisplayFor(modelItem => item.StockQuantity)
                            </span>
                        </td>

                        <!-- Active / Passive status -->
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-passive">Passive</span>
                            }
                        </td>

                        <!-- Row action links -->
                        <td class="action-links">
                            <a asp-action="Edit"
                               asp-route-id="@item.SnackId"
                               class="link-edit">
                                Edit
                            </a> |
                            <a asp-action="Details"
                               asp-route-id="@item.SnackId"
                               class="link-details">
                                Details
                            </a> |
                            <a asp-action="Delete"
                               asp-route-id="@item.SnackId"
                               class="link-delete">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>


