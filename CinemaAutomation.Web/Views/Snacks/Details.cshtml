@model CinemaAutomation.Web.Data.Entities.Snack

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Snack Details</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />  <!-- Bootstrap base styles -->

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #fff7ed, #ffedd5);
            font-family: 'Segoe UI', Tahoma, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .details-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 32px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 18px 45px rgba(0,0,0,0.18);
        }

        .details-title {
            font-weight: 900;
            color: #9a3412;
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: 0.4px;
        }

        .details-subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 0.95rem;
            margin-bottom: 24px;
        }

        dt {
            font-weight: 700;
            color: #374151;
        }

        dd {
            color: #111827;
        }

        .badge-active {
            background-color: #dcfce7;
            color: #166534;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 14px;
        }

        .badge-passive {
            background-color: #e5e7eb;
            color: #374151;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 14px;
        }

        .action-links {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
        }

        .edit-link {
            font-weight: 700;
            text-decoration: none;
            color: #f97316;
        }

            .edit-link:hover {
                text-decoration: underline;
            }

        .back-link {
            font-weight: 600;
            text-decoration: none;
            color: #9a3412;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="details-card">

        <!-- Page header -->
        <h4 class="details-title">Snack Details</h4>
        <p class="details-subtitle">
            Detailed information about this snack item
        </p>

        <hr />

        <!-- Snack details -->
        <dl class="row mb-4">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Name) @* Snack name label *@
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Name) @* Snack name value *@
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.UnitPrice) @* Unit price label *@
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.UnitPrice) @* Unit price value *@
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.StockQuantity) @* Stock quantity label *@
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.StockQuantity) @* Stock quantity value *@
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.IsActive) @* Active status label *@
            </dt>
            <dd class="col-sm-8">
                @* Display status badge based on active flag *@
                @if (Model.IsActive)
                {
                    <span class="badge-active">Active</span>
                }
                else
                {
                    <span class="badge-passive">Passive</span>
                }
            </dd>
        </dl>

        <!-- Action links -->
        <div class="action-links">
            @* Navigate to edit page for this snack *@
            <a asp-action="Edit"
               asp-route-id="@Model?.SnackId"
               class="edit-link">
                Edit
            </a>

            @* Navigate back to snack list *@
            <a asp-action="Index"
               class="back-link">
                ← Back to Snack List
            </a>
        </div>

    </div>

</body>
</html>

